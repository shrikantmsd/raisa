# Copy to .env and fill in real values for anything beyond local dev.
# Never commit the real .env (see .gitignore). Spec §7.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://raisa_synapse:devpassword_local_only@localhost:5432/raisa_synapse_dev
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=raisa-synapse-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Generate real random values before anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION
SESSION_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION
ENCRYPTION_KEYS=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION

APPLICATION_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
